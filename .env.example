# ============================================================
# 环境变量配置模板
# 复制此文件为 .env 并填入实际值（不要将 .env 提交到 Git）
# ============================================================

# # ── LLM API 配置（必须）──────────────────────────────────────
# # OpenAI API Key（或兼容 OpenAI 格式的 API Key）
# OPENAI_API_KEY=your-openai-api-key-here

# # API Base URL，默认使用 OpenAI 官方；如使用其他兼容网关请修改
# OPENAI_API_BASE=https://api.openai.com/v1

# # 模型名称
# MODEL_NAME=gpt-4o-mini

# ── UMLS 配置（可选，用于医学术语标准化）────────────────────
# 申请地址: https://uts.nlm.nih.gov/uts/signup-login
UMLS_API_KEY=your-umls-api-key-here
USE_UMLS=true
UMLS_USE_PROXY=false

# ── ICD-10 BERT 向量检索配置（可选）─────────────────────────
# 启用 BERT 向量语义检索
ICD10_USE_BERT=1

# 模型路径（本地目录）或 HuggingFace/ModelScope 模型 ID
ICD10_BERT_MODEL=BAAI/bge-small-zh-v1.5

# BERT Top1 自动采纳的余弦相似度阈值
ICD10_BERT_MIN_SIM=0.70

# ── Step 6/7 数据源配置（可选）──────────────────────────────
# 数据来源: original（自有数据集）或 mimic（MIMIC-IV 衍生数据）
DATA_SOURCE=original

# Step 6 一致性通过阈值（0.0–1.0）
CONFIDENCE_THRESHOLD=0.70
